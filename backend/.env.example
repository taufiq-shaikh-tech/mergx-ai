# ==============================================================================
# MergeX AI Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file with production secrets.
# ==============================================================================

# Application Settings
PROJECT_NAME="MergeX AI Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of allowed frontend origin URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Supabase Auth & Project Configuration
# Match these with your frontend/src/services/supabase.ts configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key"

# Supabase Service Role Key (Backend ONLY - NEVER expose to frontend or client)
# Used for backend administrative operations and database interactions
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Supabase JWT Secret (Backend ONLY)
# Used to verify JWT tokens issued by Supabase Auth (Found in Supabase Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Supabase PostgreSQL Database URL (Optional direct connection)
# postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=""
